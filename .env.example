# =============================================================================
# ARQUIVO DE EXEMPLO: .env.example
# PARA QUE SERVE: Este é um modelo de etiqueta. 
# COMO USAR: Basta criar um novo arquivo de texto chamado apenas ".env" 
# na mesma pasta deste arquivo, e colar os seus dados reais do Supabase 
# substituindo os textos abaixo!
# =============================================================================

# 1. Cole aqui o link do seu projeto do Supabase (Project URL)
VITE_SUPABASE_URL=insira_o_link_do_seu_supabase_aqui

# 2. Cole aqui a chave pública anônima do Supabase (API Anon Key)
VITE_SUPABASE_ANON_KEY=insira_a_sua_chave_anonima_aqui
